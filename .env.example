APP_VERSION=0.9.0
BACKEND_IMAGE=ghcr.io/p-r-t-r/pcb-kartoteka-backend-stable
FRONTEND_IMAGE=ghcr.io/p-r-t-r/pcb-kartoteka-frontend-stable
BACKEND_DIGEST=sha256:c8b3bae30c4825247b137f900bd7ac7bb59902bfd9e3093505b743687ea35f6d
FRONTEND_DIGEST=sha256:5922c56ea3b266e217e06657b9d1b1ecc84499dc954bae83f17afa360ab6806d

BIND_IP=127.0.0.1
HTTP_PORT=18003
PUBLIC_BASE_URL=https://pcb.example.com
CORS_ORIGINS=https://pcb.example.com
PUBLIC_READ_ENABLED=false

POSTGRES_DB=pcb_catalog
POSTGRES_USER=pcb_user
POSTGRES_PASSWORD=CHANGE_ME_URL_SAFE_DATABASE_PASSWORD
DATABASE_URL=postgresql+asyncpg://pcb_user:CHANGE_ME_URL_SAFE_DATABASE_PASSWORD@postgres:5432/pcb_catalog

SECRET_KEY=CHANGE_ME_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
JWT_SECRET=CHANGE_ME_DIFFERENT_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
JWT_EXPIRE_HOURS=24
ADMIN_USER=admin
ADMIN_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD

WEB_CONCURRENCY=2
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=10
DB_POOL_RECYCLE_SECONDS=1800

BACKUP_RETENTION_DAYS=14

# Optional Activity service overlay (see docs/ACTIVITY.md).
ACTIVITY_DB_PASSWORD=CHANGE_ME_URL_SAFE_ACTIVITY_OWNER_PASSWORD
ACTIVITY_CORE_DB_PASSWORD=CHANGE_ME_URL_SAFE_OUTBOX_READER_PASSWORD
ACTIVITY_RUNTIME_PASSWORD=CHANGE_ME_URL_SAFE_ACTIVITY_WRITER_PASSWORD
ACTIVITY_POLL_INTERVAL_SECONDS=1
ACTIVITY_RETRY_DELAY_SECONDS=5
ACTIVITY_BATCH_SIZE=50
