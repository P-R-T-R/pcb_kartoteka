# PCB Kartoteka deployment example.
# Copy to .env and replace all values before running.

APP_VERSION=CHANGE_ME

HTTP_PORT=18003
BIND_IP=127.0.0.1
PUBLIC_BASE_URL=https://pcb.example.com
CORS_ORIGINS=https://pcb.example.com

POSTGRES_DB=pcb_catalog
POSTGRES_USER=pcb_user
POSTGRES_PASSWORD=generate-strong-db-password

SECRET_KEY=generate-strong-secret-key
JWT_SECRET=generate-strong-jwt-secret

ADMIN_USER=admin
ADMIN_PASSWORD=generate-strong-admin-password
