APP_VERSION=CHANGE_ME
BACKEND_IMAGE=ghcr.io/CHANGE_ME/pcb-kartoteka-backend
FRONTEND_IMAGE=ghcr.io/CHANGE_ME/pcb-kartoteka-frontend

BIND_IP=127.0.0.1
HTTP_PORT=18003
PUBLIC_BASE_URL=https://pcb.example.com
CORS_ORIGINS=https://pcb.example.com
PUBLIC_READ_ENABLED=false

POSTGRES_DB=pcb_catalog
POSTGRES_USER=pcb_user
POSTGRES_PASSWORD=CHANGE_ME_URL_SAFE_DATABASE_PASSWORD
DATABASE_URL=postgresql+asyncpg://pcb_user:CHANGE_ME_URL_SAFE_DATABASE_PASSWORD@postgres:5432/pcb_catalog

SECRET_KEY=CHANGE_ME_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
JWT_SECRET=CHANGE_ME_DIFFERENT_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
JWT_EXPIRE_HOURS=24
ADMIN_USER=CHANGE_ME_ADMIN_NAME
ADMIN_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD

WEB_CONCURRENCY=2
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=10
DB_POOL_RECYCLE_SECONDS=1800

BACKUP_RETENTION_DAYS=14
